<?xml version="1.0" encoding="UTF-8"?>

<configuration>
  <appender name="dist_events" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <append>true</append>
        <file>${xnat.home}/logs/dist-events.log</file>
        <encoder>
            <pattern>%d [%t] %-5p %c - %m%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${xnat.home}/logs/dist-events.log.%d{yyyy-MM-dd}</fileNamePattern>
        </rollingPolicy>
  </appender>
  <logger name="io.xnatworks.events.distributed" additivity="false" level="WARN">
     <appender-ref ref="dist_events"/>
 </logger>
</configuration>
